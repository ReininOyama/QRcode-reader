#!/usr/bin/python3
#
import os
from tkinter import *
from tkinter import ttk
import tkinter.font
import subprocess

os.chdir('/tmp')
root = Tk()
url = StringVar()
tgl = StringVar()
font = tkinter.font.Font(
	root,
	family = "FixedSys",
	size = 14)
e1 = Entry(root,bd=1,width=42,font=font,bg="#fbf0fb")

def exec_subprocess(cmd: str, raise_error=True):
	child = subprocess.Popen(cmd, shell=True,
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE)
	stdout, stderr = child.communicate()
	rt = child.returncode
	return stdout, stderr, rt

def url_open():
	if url.get() == "":
		return 0
	os.system("/usr/bin/xdg-open "+url.get()+" >/dev/null 2>&1 &")
	return 0

def q_read():
	out0, out1, rt0 = exec_subprocess("/usr/bin/zbarcam --raw 0 -1 --prescale=800x600 "+tgl.get())
	url.set(out0.decode())
	e1.insert(0,url.get())
	os.system("echo '"+url.get()+"'| xclip -r -selection clipboard -i >/dev/null")
	return 0

def main():
	root.title("QRコードリーダー")
	root.geometry("490x290+260+220")
	root.configure(bg="#fbf0fb")
	label1 = Label(root, text="ＱＲコードをクリップボードに読み込む",font=font,bg="#fbf0fb")
	menu_bar = Menu(root,bg="#fbf0fb")
	root.config(menu=menu_bar)
	dev_menu = Menu(menu_bar, tearoff=False,bg="#fbf0fb")
	menu_bar.add_cascade(label="デバイス", menu=dev_menu)
	stdout, stderr, rt = exec_subprocess("ls /dev|grep video")
	if rt != 0:
		print("no device")
		exit(1)
	devices = stdout.decode()
	d1 = devices.split("\n")
	tgl.set("/dev/"+d1[0])
	for dv in d1[:-1]:
		dev_menu.add_radiobutton(label="/dev/"+dv,variable=tgl,value="/dev/"+dv)
	b1 = Button(root,text="   読み込む   ",command=q_read,font=font,bg="#fbf0fb")
	b2 = Button(root,text="ブラウザを起動",command=url_open,font=font,bg="#fbf0fb")
	b3 = Button(root,text="    閉じる    ",command=root.destroy,font=font,bg="#fbf0fb")
	label1.pack(pady=5)
	e1.pack(pady=5)
	b1.pack(pady=5)
	b2.pack(pady=5)
	b3.pack(pady=5)
	root.mainloop()

if __name__ == '__main__':
	main()

